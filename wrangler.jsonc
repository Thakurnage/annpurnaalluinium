{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annpurnaalluiniumaitech",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "assets_navigation_prefers_asset_serving"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}